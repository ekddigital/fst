DATABASE_URL="postgresql://faststar_tmdconnect:DB_PASSWORD@195.250.26.111:5432/faststar_fst?sslmode=disable"

# --- TMD Hosting (faststarttalking.com) ---
# cPanel prefixes DB names and users with account username (faststar): faststar_fst, faststar_tmdconnect
#
# Primary: direct to 195.250.26.111:5432 (requires cPanel → Remote PostgreSQL for your IP)
# Test: nc -zv 195.250.26.111 5432   or   psql "postgresql://faststar_tmdconnect:DB_PASSWORD@195.250.26.111:5432/faststar_fst?sslmode=disable" -c "SELECT 1"
#
# URL-encode special chars in password (# → %23, ! → %21, @ → %40)
#
# Fallback (tunnel-only, if Remote PostgreSQL not enabled):
# 1. Terminal A: ssh -N tmd-psql   (LocalForward 5433 → server 127.0.0.1:5432)
# 2. DATABASE_URL="postgresql://faststar_tmdconnect:DB_PASSWORD@127.0.0.1:5433/faststar_fst?sslmode=disable"

