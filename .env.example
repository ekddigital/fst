# MySQL connection string for Prisma — set in .env or .env.local (never commit real values)
# Generic: mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/fst
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/fst"

# --- TMD Hosting (faststarttalking.com) — local dev via SSH tunnel ---
# 1. Terminal A: ssh -L 3307:127.0.0.1:3306 tmd   (or: ssh -N tmd-mysql)
# 2. Use cPanel MySQL user, database name, and URL-encode special chars in password (@ → %40, ! → %21)
# DATABASE_URL="mysql://TMD_DB_USER:TMD_DB_PASSWORD@127.0.0.1:3307/fst?ssl=false&connect_timeout=60&pool_timeout=60&timeout=60"
#
# Direct to server IP (only if TMD/cPanel allows remote MySQL for your IP — often disabled):
# DATABASE_URL="mysql://TMD_DB_USER:TMD_DB_PASSWORD@195.250.26.111:3306/fst?ssl=false&connect_timeout=60&pool_timeout=60&timeout=60"

# Public site URL for metadata and links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin dashboard — set at least one (never commit real values)
ADMIN_PASSWORD=""
ADMIN_API_KEY=""
