# =============================================================================
# FAST START TALKING (FST) — ENVIRONMENT VARIABLES (EXAMPLE)
# =============================================================================
# Copy to .env (server) or .env.local (Mac). Never commit real credentials.
#
# DATABASE_URL must start with postgresql:// — one line, no nested KEY= prefixes.
# cPanel Node env vars: Name = DATABASE_URL, Value = postgresql://... (no quotes, no "DATABASE_URL=" in Value)
#
# cPanel prefixes DB/user with account username (faststar): faststar_fst, faststar_tmdconnect
# URL-encode special chars in password (# → %23, ! → %21, @ → %40)

# -----------------------------------------------------------------------------
# Mac / local development
# -----------------------------------------------------------------------------
# Direct to TMD server IP (requires cPanel → Remote PostgreSQL for your IP).
# Test: nc -zv 195.250.26.111 5432
#
# Tunnel fallback (if Remote PostgreSQL disabled):
#   Terminal A: ssh -N tmd-psql   (LocalForward 5433 → server 127.0.0.1:5432)
#   DATABASE_URL="postgresql://faststar_tmdconnect:DB_PASSWORD@127.0.0.1:5433/faststar_fst?sslmode=disable"

DATABASE_URL="postgresql://faststar_tmdconnect:DB_PASSWORD@195.250.26.111:5432/faststar_fst?sslmode=disable"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_PASSWORD=""
# ADMIN_API_KEY=""   # optional: Bearer token for /api/admin/*

# -----------------------------------------------------------------------------
# TMD server (~/coding/fst/.env) — when running ON 195.250.26.111
# -----------------------------------------------------------------------------
# Use 127.0.0.1:5432 — NOT 195.250.26.111 (PostgreSQL is local on the host).
# No quotes around values in server .env (Prisma reads the file directly).
#
# DATABASE_URL=postgresql://faststar_tmdconnect:DB_PASSWORD@127.0.0.1:5432/faststar_fst?sslmode=disable
# ADMIN_PASSWORD=your-strong-admin-password
# NEXT_PUBLIC_SITE_URL=https://app.faststarttalking.com
