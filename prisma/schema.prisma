generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  VIDEO
  PDF
  ARTICLE
  EXTERNAL
  GUIDE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum ResourceRequestStatus {
  PENDING
  SENT
  CLOSED
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PromotionPlacement {
  HOME_BANNER
  TOP_BAR
  ANNOUNCEMENT
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  email     String   @db.VarChar(191)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ResourceCategory {
  id          String     @id @default(cuid())
  slug        String     @unique @db.VarChar(191)
  title       String     @db.VarChar(255)
  description String?    @db.Text
  sortOrder   Int        @default(0)
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  resources   Resource[]

  @@index([sortOrder])
  @@index([published])
}

model Resource {
  id           String           @id @default(cuid())
  categoryId   String
  category     ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug         String           @unique @db.VarChar(191)
  title        String           @db.VarChar(255)
  description  String?          @db.Text
  type         ResourceType
  videoUrl     String?          @db.VarChar(512)
  pdfPath      String?          @db.VarChar(512)
  externalUrl  String?          @db.VarChar(512)
  articleSlug  String?          @db.VarChar(191)
  subsection   String?          @db.VarChar(191)
  sortOrder    Int              @default(0)
  published    Boolean          @default(true)
  requestable  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  views        ResourceView[]

  @@index([categoryId, sortOrder])
  @@index([published])
}

model ResourceView {
  id              String   @id @default(cuid())
  resourceId      String
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  durationSeconds Int      @default(0)
  sessionId       String   @db.VarChar(64)
  createdAt       DateTime @default(now())

  @@index([resourceId])
  @@index([createdAt])
  @@index([sessionId])
}

model ResourceRequest {
  id            String                @id @default(cuid())
  fullName      String                @db.VarChar(191)
  email         String                @db.VarChar(191)
  wechatId      String?               @db.VarChar(191)
  resourceSlug  String                @db.VarChar(191)
  resourceTitle String                @db.VarChar(255)
  status        ResourceRequestStatus @default(PENDING)
  createdAt     DateTime              @default(now())

  @@index([createdAt])
  @@index([status])
}

model Assessment {
  id          String                 @id @default(cuid())
  slug        String                 @unique @db.VarChar(191)
  title       String                 @db.VarChar(255)
  description String?                @db.Text
  targetAge   String?                @db.VarChar(64)
  published   Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt
  questions   AssessmentQuestion[]
  submissions AssessmentSubmission[]

  @@index([published])
}

model AssessmentQuestion {
  id            String       @id @default(cuid())
  assessmentId  String
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section       String       @db.VarChar(64)
  sortOrder     Int          @default(0)
  prompt        String       @db.Text
  type          QuestionType
  options       Json?
  correctAnswer String?      @db.VarChar(512)
  points        Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@index([assessmentId, sortOrder])
}

model AssessmentSubmission {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  studentName  String     @db.VarChar(191)
  parentEmail  String?    @db.VarChar(191)
  age          Int?
  answers      Json
  score        Int?
  maxScore     Int?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([assessmentId])
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(191)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  content     String    @db.Text
  coverImage  String?   @db.VarChar(512)
  published   Boolean   @default(true)
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
  @@index([published])
  @@index([publishedAt])
}

model Bill {
  id          String     @id @default(cuid())
  description String     @db.VarChar(255)
  amount      Decimal    @db.Decimal(10, 2)
  status      BillStatus @default(PENDING)
  dueDate     DateTime?
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([dueDate])
}

model Promotion {
  id        String             @id @default(cuid())
  title     String             @db.VarChar(255)
  body      String             @db.Text
  active    Boolean            @default(true)
  startDate DateTime?
  endDate   DateTime?
  placement PromotionPlacement @default(HOME_BANNER)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([active])
  @@index([placement])
}
